{
  "appName": "Agent Orbit",
  "version": "0.1.2",
  "settings": {
    "locale": "zh",
    "theme": "dark",
    "refreshSeconds": 120,
    "staleSeconds": 600,
    "requestTimeoutSeconds": 20,
    "interactionTimeoutSeconds": 300,
    "warningPercent": 20,
    "alwaysOnTop": true,
    "compact": false,
    "startAtLogin": false,
    "visibleProviders": [
      "claude",
      "codex",
      "gemini",
      "antigravity",
      "cursor",
      "copilot",
      "windsurf"
    ],
    "windowWidth": 430,
    "windowHeight": 640,
    "expandedWidth": 1040,
    "expandedHeight": 760,
    "maxOutputBytes": 1048576,
    "windowMode": "floating",
    "summaryPolicy": "shortest",
    "islandWidth": 520,
    "islandHeight": 88,
    "externalSessionLimit": 50,
    "externalSessionRefreshSeconds": 30,
    "dockSide": "right",
    "dockSize": 60,
    "dockGap": 10,
    "dockPadding": 10,
    "dockPanelWidth": 360,
    "dockEdgeInset": 12,
    "dockHoverDelayMs": 180,
    "dockChromeHeight": 64,
    "dockPopupHeight": 580
  },
  "providers": [
    {
      "id": "claude",
      "name": "Claude Code",
      "publisher": "Anthropic",
      "icon": "/icons/claude.svg",
      "color": "#c98066",
      "executables": ["claude"],
      "adapter": "claude",
      "usageUrl": "https://claude.ai/settings/usage",
      "credentialPaths": [".claude/.credentials.json"],
      "detectionPaths": [".claude"],
      "executablePaths": [
        "~/.local/bin/claude",
        "~/.nvm/versions/node/*/bin/claude",
        "~/.volta/bin/claude",
        "~/.fnm/node-versions/*/installation/bin/claude",
        "~/Library/Application Support/fnm/node-versions/*/installation/bin/claude",
        "/opt/homebrew/bin/claude",
        "/usr/local/bin/claude",
        "${APPDATA}/npm/claude.cmd",
        "${LOCALAPPDATA}/Microsoft/WinGet/Links/claude.exe"
      ]
    },
    {
      "id": "codex",
      "name": "Codex",
      "publisher": "OpenAI",
      "icon": "/icons/codex.svg",
      "color": "#a9d6c2",
      "executables": ["codex"],
      "adapter": "codex",
      "usageUrl": "https://chatgpt.com/codex/settings/usage",
      "credentialPaths": [".codex/auth.json"],
      "detectionPaths": [".codex"],
      "executablePaths": [
        "~/.local/bin/codex",
        "~/.nvm/versions/node/*/bin/codex",
        "~/.volta/bin/codex",
        "~/.fnm/node-versions/*/installation/bin/codex",
        "~/Library/Application Support/fnm/node-versions/*/installation/bin/codex",
        "/opt/homebrew/bin/codex",
        "/usr/local/bin/codex",
        "${APPDATA}/npm/codex.cmd",
        "${LOCALAPPDATA}/Microsoft/WinGet/Links/codex.exe",
        "/Applications/Codex.app/Contents/Resources/codex",
        "/Applications/Codex.app/Contents/Resources/bin/codex",
        "~/Applications/Codex.app/Contents/Resources/codex",
        "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
        "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
        "~/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
        "${LOCALAPPDATA}/Programs/Codex/resources/codex.exe"
      ],
      "desktopPaths": [
        "/Applications/Codex.app",
        "~/Applications/Codex.app",
        "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app",
        "~/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app",
        "${LOCALAPPDATA}/Programs/Codex/Codex.exe"
      ],
      "sessionIndexPaths": ["state_*.sqlite"],
      "sessionLogPaths": ["sessions/*/*/*/*.jsonl"],
      "configEnv": "CODEX_HOME"
    },
