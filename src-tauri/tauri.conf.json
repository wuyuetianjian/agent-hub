{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Orbit",
  "version": "0.1.5",
  "identifier": "dev.agent-orbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Orbit",
        "width": 80,
        "height": 580,
        "minWidth": 64,
        "minHeight": 80,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": false
      },
      {
        "label": "workspace",
        "title": "Agent Orbit",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": false,
        "visible": false,
        "focus": false,
        "shadow": true,
        "url": "index.html?workspace=1",
        "skipTaskbar": false
      },
      {
        "label": "dock-panel",
        "title": "Agent Orbit",
        "width": 360,
        "height": 580,
        "minWidth": 1,
        "minHeight": 1,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "skipTaskbar": true,
        "focusable": true,
        "url": "index.html?panel=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agent quotas and interactive CLI companion",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
